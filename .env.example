# SoundWave Environment Configuration Example

# ==============================================================================
# Supabase Authentication & PostgreSQL Database (Optional Cloud Sync)
# ==============================================================================
# Register a free project at https://supabase.com/
# Copy the Project URL and Project Anon/Public Key from Project Settings -> API.
# If these variables are not provided, SoundWave automatically runs its built-in
# secure cryptographic engine (Web Crypto API PBKDF2/SHA-256) locally.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Supabase PostgreSQL SQL Schema for Profiles & Preferences:
# Run this SQL query in your Supabase SQL Editor to initialize the profiles table:
#
# CREATE TABLE public.profiles (
#   id UUID PRIMARY KEY REFERENCES auth.users(id) ON DELETE CASCADE,
#   name TEXT NOT NULL,
#   email TEXT NOT NULL,
#   preferences JSONB DEFAULT '{"preferredLanguages":[],"favouriteSingers":[],"preferredGenres":[],"preferredMoods":[],"onboardingCompleted":false}'::jsonb,
#   updated_at TIMESTAMPTZ DEFAULT NOW()
# );
#
# -- Enable Row Level Security (RLS)
# ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
#
# -- Policies allowing users to read and update only their own profile:
# CREATE POLICY "Users can view own profile" ON public.profiles FOR SELECT USING (auth.uid() = id);
# CREATE POLICY "Users can insert own profile" ON public.profiles FOR INSERT WITH CHECK (auth.uid() = id);
# CREATE POLICY "Users can update own profile" ON public.profiles FOR UPDATE USING (auth.uid() = id);
# ------------------------------------------------------------------------------

# ==============================================================================
# Music APIs (Optional)
# ==============================================================================
# (Optional) Jamendo Music API - For searching 600,000+ Creative Commons songs
# Register at: https://devportal.jamendo.com/
VITE_JAMENDO_CLIENT_ID=

# (Optional) Spotify Web API & Web Playback SDK
# Register at: https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=http://localhost:5173/callback

# Default Dev Server Port
VITE_PORT=5173
